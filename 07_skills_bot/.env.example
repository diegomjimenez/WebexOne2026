# Copy this file to .env and fill in your values. Never commit real tokens.
#
# 07_skills_bot (Lab 7)
# 01 and 02 need NO credentials.
# 03 needs OPENAI_API_KEY; WEBEX_MEETING_MCP_TOKEN is optional
# (a canned dataset is used when the token is absent).

# ── OpenAI (REQUIRED for 03) ────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# ── Webex Meetings MCP (OPTIONAL for 03) ────────────────────────────────────
# When set, 03 queries your live Webex Meetings schedule via MCP.
# When absent, it uses built-in sample meeting data instead.
WEBEX_MEETING_MCP_TOKEN=
