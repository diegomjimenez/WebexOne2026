# ---------------------------------------------------------------------------
# WxCC MCP Server configuration (example)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# All values below are PLACEHOLDERS. Items marked VERIFY/TODO must be resolved
# against https://developer.webex.com before running against live APIs.
# ---------------------------------------------------------------------------

# --- OAuth 2.0 client credentials (from your Webex integration) -------------
WXCC_CLIENT_ID=your-client-id-here
WXCC_CLIENT_SECRET=your-client-secret-here
# Redirect URI registered on your Webex integration.
WXCC_REDIRECT_URI=http://localhost:8765/oauth/callback

# --- Org context ------------------------------------------------------------
# Default org id used when a tool call omits org_id (optional).
WXCC_ORG_ID=your-org-id-here

# --- Personal access token (optional dev/bypass mode) ----------------------
# Set this to skip the full OAuth browser flow (useful for local dev/testing).
# Get one from https://developer.webex.com (logged in, click "Copy" your token)
# or from a WxCC integration token with cjp:config_read + cjp:config_write.
# Leave blank in production — use the full OAuth flow instead.
WXCC_ACCESS_TOKEN=

# --- API base URL (single Config family) ------------------------------------
# VERIFY the base URL against developer.webex.com. This lab uses only the WxCC
# Config API family (Address Books, Entries, Desktop Profiles, Users).
WXCC_CONFIG_API_BASE=https://api.wxcc-REGION.cisco.com   # VERIFY

# --- OAuth endpoints --------------------------------------------------------
# VERIFY the exact authorization and token endpoints against developer.webex.com.
WXCC_OAUTH_AUTHORIZE_URL=https://webexapis.com/v1/authorize  # VERIFY
WXCC_OAUTH_TOKEN_URL=https://webexapis.com/v1/access_token   # VERIFY

# --- OAuth scopes -----------------------------------------------------------
# Config API reads use cjp:config_read; writes use cjp:config_write. Space-separated.
WXCC_CONFIG_API_SCOPES=cjp:config_read cjp:config_write  # VERIFY

# --- Token store ------------------------------------------------------------
# Directory for the encrypted per-session token store (Phase 1 local backend).
WXCC_TOKEN_STORE_DIR=.tokens
# Base64-encoded 32-byte key for encrypting tokens at rest.
# Generate with: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
WXCC_TOKEN_ENCRYPTION_KEY=generate-a-32-byte-base64-key-here

# --- HTTP client tuning -----------------------------------------------------
WXCC_HTTP_TIMEOUT_SECONDS=30
WXCC_HTTP_MAX_RETRIES=4

# --- Logging ----------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR
WXCC_LOG_LEVEL=INFO
