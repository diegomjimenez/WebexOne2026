# Copy this file to .env and fill in your values. Never commit real tokens.

# ── Bot identity (both scripts) ─────────────────────────────────────────────
BOT_TOKEN=

# ── LLM (both scripts) ──────────────────────────────────────────────────────
OPENAI_API_KEY=
MODEL=gpt-5-nano

# ── Contact Center MCP servers 06 + 07 (both scripts) ───────────────────────
# Service App token with Contact Center admin scopes.
WEBEX_ACCESS_TOKEN=
# Your Webex organization ID.
WEBEX_ORG_ID=
# WXCC Configuration API base URL (region-specific).
WXCC_CONFIG_API_BASE=
