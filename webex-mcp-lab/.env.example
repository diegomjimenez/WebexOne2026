# Copy this file to .env and fill in your values. Never commit a real token.
# Chapters 01-02 need none of these. Chapters 03-06 need all three.

# Your Webex access token (scopes: cjp:config_read, cjp:config_write).
WEBEX_ACCESS_TOKEN=

# Your Webex Contact Center organization id.
WEBEX_ORG_ID=

# Your Contact Center Config API base URL (e.g. us1, eu1, anz1).
WXCC_CONFIG_API_BASE=https://api.wxcc-us1.cisco.com
