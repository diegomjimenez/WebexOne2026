# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored. Never commit a real token.

# --- Required for every step ------------------------------------------------
# A Webex access token. Get a personal one (valid 12 hours) from
# https://developer.webex.com/docs/getting-started, or create a bot and use its
# token from https://developer.webex.com/my-apps.
WEBEX_ACCESS_TOKEN=

# --- Required from step 07 onward (Webex Contact Center) --------------------
# Steps 01-06 call the ordinary Webex APIs and need nothing below this line.
# Step 07 calls the Contact Center Config API, which needs an organization and
# the cjp:config_read / cjp:config_write scopes.

# Your Contact Center organization id.
WEBEX_ORG_ID=

# Your Contact Center data centre. Replace REGION with yours, e.g. us1, eu1, anz1.
WEBEX_CC_API_BASE=https://api.wxcc-REGION.cisco.com
