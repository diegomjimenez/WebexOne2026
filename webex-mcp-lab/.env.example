# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored. Never commit a real token.
#
# The whole lab (every chapter except 01) talks to Webex Contact Center, so all
# three variables below are needed from chapter 02 onward. Chapter 01 needs none
# of them - it makes no network call.

# A Webex access token whose scopes include cjp:config_read and cjp:config_write.
# Get one from https://developer.webex.com/docs/getting-started (personal, valid
# 12 hours) or create a bot at https://developer.webex.com/my-apps.
WEBEX_ACCESS_TOKEN=

# Your Webex Contact Center organization id.
WEBEX_ORG_ID=

# Your Contact Center Config API base URL - the data centre you belong to,
# e.g. https://api.wxcc-us1.cisco.com (or eu1, anz1, ...).
WXCC_CONFIG_API_BASE=https://api.wxcc-us1.cisco.com
