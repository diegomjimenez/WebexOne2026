# Copy this file to .env and fill in your values. Never commit real tokens.

# Your Webex bot token (create at https://developer.webex.com/my-apps).
BOT_TOKEN=

# Approved email domain for the bot (messages from other domains are ignored).
DOMAIN=

# Your OpenAI API key (used by the MCP client and the bot).
OPENAI_API_KEY=

# ── MCP server connection (REQUIRED) ────────────────────────────────────────
# This bot is MCP-server-agnostic: it connects to whatever server you set here.
# MCP_SERVER_ARGS is required; the bot exits with a clear error if it is unset.
# Example below points at the Contact Center agents server that ships with the lab.
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=07_agents_server.py
MCP_SERVER_CWD=../mcp_servers

# ── Model (optional) ────────────────────────────────────────────────────────
# MODEL=gpt-4o-mini
# MAX_HISTORY=20

# ── System prompt (optional) ────────────────────────────────────────────────
# Base persona is loaded from system_prompt.txt next to the script by default.
# Override with an absolute or relative path to reuse the bot for another domain.
# SYSTEM_PROMPT_FILE=./system_prompt.txt

# ── Configurable slash command (optional) ───────────────────────────────────
# Triggers one of the connected server's prompts as an explicit "/keyword".
# Leave SETUP_PROMPT_NAME empty to disable the command.
# SETUP_COMMAND_KEYWORD=setup
# SETUP_PROMPT_NAME=diagnose_agent_availability
# SETUP_PROMPT_ARGS={"team": "", "agent": ""}

# ── Skills directory (optional) ─────────────────────────────────────────────
# Defaults to ./skills relative to the script.
# SKILLS_DIR=./skills
