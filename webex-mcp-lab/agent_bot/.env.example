# Copy this file to .env and fill in your values. Never commit real tokens.

# Your Webex bot token (create at https://developer.webex.com/my-apps).
BOT_TOKEN=

# Approved email domain for the bot (messages from other domains are ignored).
DOMAIN=


# Your OpenAI API key (used by mcp_client.py and 07_agentbot.py).
OPENAI_API_KEY=

# MCP server connection (08 and 09 only). Defaults work if you run from agent_bot/

MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=
MCP_SERVER_CWD=


# Skills directory (09 only). Defaults to ./skills relative to the script.
# SKILLS_DIR=./skills